# Copy to .env and fill in. Never commit .env.
# The pipeline refuses to start if the key for an enabled provider is missing.

GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gemini-2.5-flash-lite
GAPGPT_INPUT_USD_PER_MILLION=0.10
GAPGPT_OUTPUT_USD_PER_MILLION=0.40

# Local model runtime. Ollama exposes an OpenAI-compatible endpoint, so the same
# provider class talks to it. Point a node at it in config/routing.yaml.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Hard ceiling per run, USD. Run aborts rather than exceeding it. This is the money guard.
NEWS_RUN_BUDGET_USD=1.00

# Runaway circuit breaker: total provider requests per run, not per article. A cycle of
# 25 articles issues up to 75. Set it above any legitimate cycle - too low aborts the run
# partway through and stops run-loop, which is worse than the runaway it guards against.
NEWS_MAX_PROVIDER_CALLS=500

NEWS_MAX_OUTPUT_TOKENS=350
