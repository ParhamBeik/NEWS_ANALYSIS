# Copy to deploy/.env on the VPS and fill in. NEVER commit the real file - this repository
# is public, and a key in a public git history is a key you have to rotate, not delete.
#
#   ssh root@<vps> 'mkdir -p /opt/apps/news-intel/deploy'
#   scp deploy/.env.example root@<vps>:/opt/apps/news-intel/deploy/.env
#   ssh root@<vps> 'chmod 600 /opt/apps/news-intel/deploy/.env && vi ...'
#
# THE SERVER'S .env IS HAND-WRITTEN. Adding a key here does not put it on the VPS - this
# file is documentation, not a deployment artifact, and deploy.yml only ever rewrites the
# two *_IMAGE lines. A key added here has to be added to the server file by hand.
#
# Keys set in docker-compose.prod.yml's `environment:` block are NOT listed here, because
# `environment:` overrides `env_file` - setting them here would do nothing. Those are:
# DJANGO_SETTINGS_MODULE, POSTGRES_HOST, REDIS_URL, EXPORT_DIR, BACKUP_DIR and
# DRF_NUM_PROXIES. Change them in the compose file.

# Set by compose; this line would be ignored. Shown so the value is discoverable.
#DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
# `backend` belongs in this list: container healthchecks and the Next server-side fetch
# reach Django on its internal hostname, and Django rejects a Host header it does not know.
DJANGO_ALLOWED_HOSTS=news.example.com,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://news.example.com

# ONE reverse proxy (the shared Caddy edge) sits in front of gunicorn. This is what lets a
# rate limit identify the caller instead of the proxy. It MUST match reality: too low and
# every request looks like it came from Caddy, so one attacker exhausts everyone's
# allowance; leave it unset and DRF reads the whole X-Forwarded-For header, which the
# caller also controls, so inventing a value per request buys a fresh allowance each time.
# Set by compose, so this line is inert - change it in docker-compose.prod.yml.
#DRF_NUM_PROXIES=1
# Rate limits on the only two endpoints an unauthenticated caller can reach. These are
# per client address, not global, so they are sized for a whole office behind one NAT
# rather than for one person: a demo room signing up together must not exhaust the hour.
# Still low enough that a script gets nothing useful out of either endpoint.
THROTTLE_LOGIN=60/min
THROTTLE_SIGNUP=60/hour

POSTGRES_DB=newsintel
POSTGRES_USER=newsintel
POSTGRES_PASSWORD=replace-with-a-database-password

GAPGPT_API_KEY=replace-with-your-gapgpt-key
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# Chosen by `manage.py benchmark_models` over 60 real Persian articles: 97.1% schema
# compliance at $0.000175/article. Re-run the command to challenge it.
GAPGPT_MODEL=gemini-3.1-flash-lite
GAPGPT_EMBEDDING_MODEL=text-embedding-3-small
GAPGPT_EMBEDDING_DIM=1536
# Fallback pricing, used only when the provider does not report cost on a response. If
# these drift from the real tariff, every budget ceiling is enforced against the wrong
# number - silently, because nothing compares them to an invoice.
GAPGPT_INPUT_USD_PER_MILLION=0.10
GAPGPT_OUTPUT_USD_PER_MILLION=0.40

# Two ceilings because they fail differently: one runaway run, and a slow drift over a day.
NEWS_RUN_BUDGET_USD=1.00
NEWS_DAILY_BUDGET_USD=3.00
# A breaker on request COUNT, not money: a retry storm that never succeeds spends nothing
# the cost ceiling can see, but is exactly the runaway worth stopping.
NEWS_MAX_PROVIDER_CALLS_PER_RUN=1000
# Also a model selection criterion - see config/settings/base.py.
NEWS_MAX_OUTPUT_TOKENS=350
NEWS_ROLLING_WINDOW_DAYS=14
NEWS_CRAWL_LIMIT_PER_SOURCE=40
#NEWS_HTTP_TIMEOUT=20
#NEWS_USER_AGENT=news-intel/2.0 (+research pipeline; contact via site)

# ------------------------------------------------------------------ provider circuit
# The automatic halt. The first empty-wallet response opens the circuit and only the
# weekly probe may try again, so these decide how long a topped-up wallet stays unused.
# Commented lines are the code's own defaults; uncomment only to change one.
#NEWS_CIRCUIT_ERROR_THRESHOLD=5
#NEWS_CIRCUIT_PROBE_DAYS=7
#NEWS_CIRCUIT_PROBE_FAIL_STOP=3
# Check the wallet before dispatching a cycle, so an empty account costs one call rather
# than one per article.
#NEWS_INFERENCE_PREFLIGHT=1

# ------------------------------------------------------------------------ operational
#POSTGRES_CONN_MAX_AGE=60
#CELERY_TASK_TIME_LIMIT=900
#CELERY_TASK_SOFT_TIME_LIMIT=840
#DJANGO_LOG_LEVEL=INFO
# Defaults derive from REDIS_URL, which compose sets. The cache MUST stay on a different
# logical database from the broker: cache.clear() issues FLUSHDB, and pointing it at db 0
# would delete every queued task.
#CACHE_URL=redis://redis:6379/1
#CELERY_RESULT_BACKEND=redis://redis:6379/0
# Not set anywhere: the default (BASE_DIR/media) is already /app/media, which is where the
# media volume mounts. Changing one without the other silently splits stored images.
#MEDIA_ROOT=/app/media
# CORS is unused - the browser never calls Django directly, only the Next server does.
#CORS_ALLOWED_ORIGINS=

# Rewritten by .github/workflows/deploy.yml on every deploy. Pinning the SHA here (rather
# than relying on :latest) is what makes a rollback a one-line edit plus `up -d`.
BACKEND_IMAGE=ghcr.io/parhambeik/news_analysis-backend:latest
FRONTEND_IMAGE=ghcr.io/parhambeik/news_analysis-frontend:latest
