# Copy to deploy/.env on the VPS and fill in. NEVER commit the real file - this repository
# is public, and a key in a public git history is a key you have to rotate, not delete.
#
#   ssh root@<vps> 'mkdir -p /opt/apps/news-intel/deploy'
#   scp deploy/.env.example root@<vps>:/opt/apps/news-intel/deploy/.env
#   ssh root@<vps> 'chmod 600 /opt/apps/news-intel/deploy/.env && vi ...'

DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
# `backend` belongs in this list: container healthchecks and the Next server-side fetch
# reach Django on its internal hostname, and Django rejects a Host header it does not know.
DJANGO_ALLOWED_HOSTS=news-89-106-206-4.sslip.io,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://news-89-106-206-4.sslip.io

POSTGRES_DB=newsintel
POSTGRES_USER=newsintel
POSTGRES_PASSWORD=replace-with-a-database-password

GAPGPT_API_KEY=replace-with-your-gapgpt-key
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# Chosen by `manage.py benchmark_models` over 60 real Persian articles: 97.1% schema
# compliance at $0.000175/article. Re-run the command to challenge it.
GAPGPT_MODEL=gemini-3.1-flash-lite
GAPGPT_EMBEDDING_MODEL=text-embedding-3-small
GAPGPT_EMBEDDING_DIM=1536

# Two ceilings because they fail differently: one runaway run, and a slow drift over a day.
NEWS_RUN_BUDGET_USD=1.00
NEWS_DAILY_BUDGET_USD=3.00
# A breaker on request COUNT, not money: a retry storm that never succeeds spends nothing
# the cost ceiling can see, but is exactly the runaway worth stopping.
NEWS_MAX_PROVIDER_CALLS_PER_RUN=1000
# Also a model selection criterion - see config/settings/base.py.
NEWS_MAX_OUTPUT_TOKENS=350
NEWS_ROLLING_WINDOW_DAYS=14
NEWS_CRAWL_LIMIT_PER_SOURCE=40

# Rewritten by .github/workflows/deploy.yml on every deploy. Pinning the SHA here (rather
# than relying on :latest) is what makes a rollback a one-line edit plus `up -d`.
BACKEND_IMAGE=ghcr.io/parhambeik/news_analysis-backend:latest
FRONTEND_IMAGE=ghcr.io/parhambeik/news_analysis-frontend:latest
