# Copy to backend/.env for local development. NEVER commit the filled-in file.
#
# Every key config/settings/ reads is listed here, including the ones whose default is
# already right - a setting you cannot see is a setting you cannot reason about when the
# behaviour it controls surprises you. Commented-out lines show the code's own default;
# uncomment only to change it.
#
# Existing environment variables always win over this file (see _load_dotenv in
# config/settings/base.py), so exporting a value in your shell overrides what is here.

# --------------------------------------------------------------------------- django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-locally-and-generate-a-real-one-for-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# INFO by default. DEBUG also turns on Django's own SQL logging via the django.db.backends
# logger, which is how you see an N+1 rather than infer one.
#DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------- postgres
# 55432/56379 in local dev: a Mac with Postgres.app or Homebrew redis already owns the
# default ports on 127.0.0.1 and Docker's bind loses silently. See docker-compose.dev.yml.
POSTGRES_DB=newsintel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
#POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://localhost:56379/0
# Celery results and the cache both derive from REDIS_URL. The cache deliberately uses a
# DIFFERENT logical database (db 1), because cache.clear() issues FLUSHDB and pointing it
# at the broker's database would delete every queued task.
#CACHE_URL=redis://localhost:56379/1
#CELERY_RESULT_BACKEND=redis://localhost:56379/0
#CELERY_TASK_TIME_LIMIT=900
#CELERY_TASK_SOFT_TIME_LIMIT=840
# dev settings only. Runs tasks inline in the calling process, so `manage.py shell` can
# drive the pipeline with no worker running. Never set this on the VPS.
#CELERY_TASK_ALWAYS_EAGER=0

# ---------------------------------------------------------------------------- gapgpt
# No default anywhere in the code. A missing key fails at startup, not at the first
# paid call - a worker that boots without one looks healthy and dead-letters everything.
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# Must match what production runs, or a local bake-off measures a different model than
# the one actually serving. See the selection note in config/settings/base.py.
GAPGPT_MODEL=gemini-3.1-flash-lite
GAPGPT_EMBEDDING_MODEL=text-embedding-3-small
GAPGPT_EMBEDDING_DIM=1536
# Fallback pricing, used only when a response carries no cost field.
GAPGPT_INPUT_USD_PER_MILLION=0.10
GAPGPT_OUTPUT_USD_PER_MILLION=0.40

# --------------------------------------------------------------------------- budgets
# Two ceilings because they fail differently: one runaway run, versus slow drift over a day.
NEWS_RUN_BUDGET_USD=1.00
NEWS_DAILY_BUDGET_USD=3.00
# Runaway-loop breaker on request COUNT, not money. Set well above a legitimate cycle:
# too low aborts a run partway through, which is worse than the runaway it guards against.
NEWS_MAX_PROVIDER_CALLS_PER_RUN=1000
NEWS_MAX_OUTPUT_TOKENS=350

# ------------------------------------------------------------------ provider circuit
# Automatic provider halt. Not a user toggle: the first empty-wallet response opens the
# circuit, and only the weekly probe may try again.
#NEWS_CIRCUIT_ERROR_THRESHOLD=5
#NEWS_CIRCUIT_PROBE_DAYS=7
#NEWS_CIRCUIT_PROBE_FAIL_STOP=3
# Check the wallet before dispatching a cycle. Off in the test settings so the suite
# never makes a wallet call.
#NEWS_INFERENCE_PREFLIGHT=1

# -------------------------------------------------------------------------- crawling
NEWS_ROLLING_WINDOW_DAYS=14
NEWS_CRAWL_LIMIT_PER_SOURCE=40
#NEWS_HTTP_TIMEOUT=20
#NEWS_USER_AGENT=news-intel/2.0 (+research pipeline; contact via site)

# ----------------------------------------------------------------- paths and limits
# Where the exporter writes workbooks and category feeds. Deliberately OUTSIDE MEDIA_ROOT:
# in production the edge file-serves the whole media volume with no auth, and workbook
# filenames are deterministic. Downloads go through ExportDownloadView, which needs a login.
#EXPORT_DIR=var/exports
#BACKUP_DIR=var/backups
#MEDIA_ROOT=media

# Rate limits on the only two endpoints an unauthenticated caller can reach. Per client
# address, not global. The cache backs the counter, so these are meaningless without Redis.
#THROTTLE_LOGIN=10/min
#THROTTLE_SIGNUP=5/hour
# How many reverse proxies sit in front of this process. 0 when you reach Django directly,
# which is the local case. This is a correctness setting, not tuning - see base.py.
#DRF_NUM_PROXIES=0
